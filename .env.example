# AI Chatbot Environment Variables
# Copy this file to src/environments/environment.ts and fill in your actual values

# ============================================
# GOOGLE GEMINI API CONFIGURATION
# ============================================

# Get your free API key from: https://aistudio.google.com/app/apikey
# IMPORTANT: Never commit your actual API key to version control!
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API endpoint (usually doesn't need to change)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ============================================
# ENVIRONMENT
# ============================================

# Set to 'true' in production, 'false' in development
PRODUCTION=false

# ============================================
# INSTRUCTIONS
# ============================================

# 1. Create src/environments/environment.ts with this content:
#
# export const environment = {
#   production: false,
#   geminiApiKey: 'YOUR_ACTUAL_API_KEY',
#   geminiApiUrl: 'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent'
# };

# 2. Create src/environments/environment.prod.ts with this content:
#
# export const environment = {
#   production: true,
#   geminiApiKey: 'YOUR_ACTUAL_API_KEY',
#   geminiApiUrl: 'https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent'
# };

# 3. For Netlify deployment, set environment variables in:
#    Netlify Dashboard > Site Settings > Environment Variables
#    - GEMINI_API_KEY = your_actual_api_key

# ============================================
# SECURITY NOTES
# ============================================

# - NEVER commit environment files with real API keys
# - Add environment files to .gitignore
# - Use Netlify environment variables for production
# - Consider implementing a backend proxy for better security
# - Rotate your API keys regularly
# - Monitor API usage in Google AI Studio

# ============================================
# RATE LIMITS (Google Gemini Free Tier)
# ============================================

# Free tier limits as of 2025:
# - 60 requests per minute
# - 1,500 requests per day
# - 1 million requests per month

# The application has built-in rate limiting to help prevent exceeding these limits.
